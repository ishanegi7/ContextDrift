# Copy to .env and fill in ONE provider key. With no key, ContextDrift runs on its
# offline heuristic evaluator, so the demo works out of the box.

# LLM_PROVIDER=groq            # groq | openai | gemini | mock  (auto-detected from keys if omitted)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LLM_TIMEOUT_SECONDS=30

# Embeddings (FastEmbed downloads the model on first run; falls back to a local hashing embedder if offline)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FORCE_HASH_EMBEDDINGS=false

# Pipeline tuning
# SIMILARITY_THRESHOLD=0.70
# NEIGHBOR_K=3
# MIN_CONFIDENCE=0.50
# RETRIEVAL_MIN_SIMILARITY=0.25
# CHUNK_MIN_CHARS=300
# CHUNK_MAX_CHARS=500
# CHUNK_OVERLAP=60

# DATA_DIR=data
